{"name":"Mantle Swap","short_name":"Mantle Swap","description":"Mantle Swap lets you trade MNT, USDC, USDT and other tokens on Mantle, an Ethereum layer-2, from your own wallet. Non-custodial, no account, gas paid in MNT.","start_url":"/","display":"standalone","background_color":"#f6f5f4","theme_color":"#f6f5f4","icons":[{"src":"icon.svg","sizes":"any","type":"image/svg+xml"}]}